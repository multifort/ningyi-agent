# Repo-local environment — for PROJECT tooling only.
# NOTE: This is NOT where the Hermes provider key goes.
# Hermes' DeepSeek provider reads the key from ~/.hermes/.env (env var
# DEEPSEEK_API_KEY) and IGNORES api_key in config.yaml. Set it with:
#     hermes config set DEEPSEEK_API_KEY sk-...
# (that command writes it to ~/.hermes/.env). Never put it in this repo file.
#
# Use this file for project/app vars and tokens you want forwarded into the
# Docker backend via terminal.docker_forward_env. .env is gitignored.

# If you put the key here too, bootstrap.sh will forward it to ~/.hermes/.env:
# DEEPSEEK_API_KEY=

# REQUIRED: Server will refuse to start without this. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# JWT_SECRET=

# ── Hermes Agent integration (optional) ──────────────────────────────
# The app's Agent mode shells out to the `hermes` CLI. All optional —
# if unset, Agent mode degrades gracefully to Chat mode.
#
# HERMES_CLI_PATH=hermes              # path to the hermes binary
# HERMES_BRIDGE_MODE=subprocess       # 'subprocess' (only mode today)
# ALLOWED_SKILLS=*                    # comma list of skills, or * for all
# AGENT_MEMORY_EXTRACTION=true        # auto-extract durable memories (false to disable)

# Example: a token your build/tests need, optionally forwarded into Docker.
# GITHUB_TOKEN=
